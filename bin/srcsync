#!/bin/bash

# Set this if you want to use something other than `${HOME}/src` as your work-checkout-root
LAMBDA_SRC_DIR=${LAMBDA_SRC_DIR:-~/src}

# check if we have some necessary tools installed
type -P "gh"  > /dev/null || { echo "Need GitHub CLI installed and active, \`brew install gh;gh auth login\`"; exit 1; }
type -P "git" > /dev/null || { echo "Need git installed, \`brew install git\`"; exit 1; }
type -P "git-restore-mtime" > /dev/null || { echo "Need git-restore-mtime installed, \`brew install git-tools\`"; exit 1; }
type -P "jq"  > /dev/null || { echo "Need jq installed, \`brew install jq\`"; exit 1; }
type -P "sem" > /dev/null || { echo "Need GNU parallel (sem) installed, \`brew install parallel;parallel --citation\`"; exit 1; }

# CLI parsing, we just have the one: `-v` or `-vv`
verbose=0
while getopts qv flag; do
  case "${flag}" in
    v)
      verbose=$((verbose + 1))
      ;;
  esac
done

# see if we want to generally suppress stderr
if [[ $verbose -eq 0 ]] ; then
  # save stderr as fd3
  exec 3>&2
  exec 2> /dev/null
fi

# see if we should output more process goodness
if [[ $verbose -gt 1 ]] ; then
  set -x
fi

# snapshot before we change anything, at worst we can restore-to-snapshot if things go sideways
# this is NOT included in the tool checks at the top, since it may not exist for linux/etc but also doesn't matter
type -P "tmutil" > /dev/null && tmutil snapshot

# Make sure we have all available repos in our `pristine` dir
echo "Checking for missing repos"
cd ${LAMBDA_SRC_DIR}/pristine
for x in $(gh repo list lambdal --source --no-archived --limit 999 --json name --jq '.[]|.name'); do
  [[ -d "${x}/.git/" ]] || (echo -n "$x " && git clone git@github.com:lambdal/${x}.git 1>&2 && echo -e '\xe2\x9c\x85')
done
sem --id srcsync.clone --st -300 --wait

# update all repos in `src` and `src/pristine`
echo "Updating all repos"
cd ${LAMBDA_SRC_DIR}
for x in * pristine/*; do
  [[ -d "${x}/.git/" ]] || continue

  sem -j -2 --id srcsync.update echo $x ';' \
    cd "$x" ';' \
    git diff --exit-code HEAD '>' /dev/null '&&' \
    git fetch --prune --tags --prune-tags origin '&&' \
    git pull '&&' \
    git restore-mtime -q 1>&2
done
sem --id srcsync.update --st -300 --wait

# update submodules as well
echo "Updating submodules"
cd ${LAMBDA_SRC_DIR}
for x in */.gitmodules pristine/*/.gitmodules; do
  cd ${LAMBDA_SRC_DIR}
  wdir="${x%/.gitmodules}"
  cd $wdir
  git submodule update --init 1>&2
  git diff --exit-code HEAD > /dev/null || continue
  echo "${wdir}"
  for d in $(git submodule status | awk '{print $2}'); do
    echo -e "\t-> ${d}"
    (cd "$d" && git restore-mtime -q) 1>&2
  done
done

if [[ $verbose -eq 0 ]] ; then
  # restore stderr, probably not necessary since we're exiting
  exec 2>&3
fi
